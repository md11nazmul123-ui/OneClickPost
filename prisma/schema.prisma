// Neon (serverless PostgreSQL) এর সাথে কাজ করার জন্য প্রস্তুত।
// আগের fullstack/laravel মাইগ্রেশনের স্কিমা অনুসরণ করে বানানো হয়েছে,
// যাতে একই ডেটা মডেল বজায় থাকে।

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Platform {
  youtube
  facebook
  instagram
  tiktok
  x
  linkedin
  pinterest
}

enum PostStatus {
  draft
  processing
  scheduled
  publishing
  completed
  partially_failed
  failed
}

enum DeliveryStatus {
  pending
  queued
  uploading
  published
  failed
  retrying
}

model User {
  id               String            @id @default(uuid())
  name             String
  email            String            @unique
  emailVerifiedAt  DateTime?
  avatarUrl        String?
  tier             String            @default("pro")
  locale           String            @default("bn")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  connectedAccounts ConnectedAccount[]
  posts            Post[]

  @@map("users")
}

model ConnectedAccount {
  id              String     @id @default(uuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform        Platform
  platformUserId  String
  accountName     String
  accountHandle   String?
  avatarUrl       String?
  accessToken     String     // এনক্রিপ্ট করে রাখা উচিত (app কোডে encrypt/decrypt)
  refreshToken    String?
  tokenExpiresAt  DateTime?
  scopes          Json?
  metadata        Json?
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deliveries      PostPlatformDelivery[]

  @@unique([userId, platform, platformUserId])
  @@index([userId, platform])
  @@map("connected_accounts")
}

model Post {
  id                    String     @id @default(uuid())
  userId                String
  user                  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                 String
  caption               String
  hashtags              Json?
  videoUrl              String
  videoStoragePath      String
  thumbnailUrl          String?
  videoDurationSeconds  Int        @default(0)
  videoFileSizeBytes    BigInt     @default(0)
  status                PostStatus @default(draft)
  scheduledAt           DateTime?
  publishedAt           DateTime?
  platformOverrides     Json?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  deletedAt             DateTime?
  deliveries            PostPlatformDelivery[]

  @@index([userId, status])
  @@index([scheduledAt])
  @@map("posts")
}

model PostPlatformDelivery {
  id                  String         @id @default(uuid())
  postId              String
  post                Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  connectedAccountId  String
  connectedAccount    ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  platform            Platform
  deliveryStatus      DeliveryStatus @default(pending)
  platformPostId      String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@map("post_platform_deliveries")
}
