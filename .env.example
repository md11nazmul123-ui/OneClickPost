# --- AI ---
GEMINI_API_KEY="your_gemini_api_key"

# --- Database (Neon সার্ভারলেস PostgreSQL — neon.tech এ ফ্রি অ্যাকাউন্ট খুলে নিন) ---
DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/oneclickpost?sslmode=require"

# --- Queue / Scheduling (Upstash — upstash.com এ ফ্রি অ্যাকাউন্ট, সার্ভারলেস, Redis/Worker নিজে চালাতে হয় না) ---
QSTASH_TOKEN="your_qstash_token"
QSTASH_CURRENT_SIGNING_KEY="your_qstash_signing_key"
QSTASH_NEXT_SIGNING_KEY="your_qstash_next_signing_key"
UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_token"

# --- File / video storage (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN="your_vercel_blob_token"

# --- Auth (NextAuth.js / Auth.js) ---
NEXTAUTH_SECRET="generate_a_random_secret"
NEXTAUTH_URL="http://localhost:3000"

# --- OAuth: প্রতিটা প্ল্যাটফর্মের ডেভেলপার কনসোল থেকে নিতে হবে ---
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
META_APP_ID=""
META_APP_SECRET=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
X_CLIENT_ID=""
X_CLIENT_SECRET=""
